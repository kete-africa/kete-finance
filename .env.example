# The app's Postgres (Neon), through its application role (no BYPASSRLS).
DATABASE_URL=""
# The owner role: migrations at start-up, and the jobs' schema (kete_jobs).
OWNER_DATABASE_URL=""
# Where this app is served, e.g. https://template.kete.africa
PUBLIC_URL="http://localhost:3400"
# The Compte Kete, and this app's registration there (an operator registers it).
KETE_ACCOUNT_URL="https://compte.kete.africa"
KETE_CLIENT_ID=""
KETE_CLIENT_SECRET=""
# Signs this app's own session cookie: 32 characters at least, this app only.
SESSION_SECRET=""
# Kete's own organization: its owners and admins are Kete operators.
KETE_OPERATORS_ORGANIZATION_ID=""
# E-mails (@kete/notify): a MailKite key restricted to the sending domain; without it, nothing leaves.
MAILKITE_API_KEY=""
MAIL_FROM="Kete <bonjour@kete.africa>"
# Events to Kete Cockpit (@kete/sdk): the key the Cockpit hands out.
KETE_EVENTS_URL=""
KETE_EVENTS_KID=""
KETE_EVENTS_SECRET=""
KETE_ENVIRONMENT="development"
# The center (Kete Enterprise): the person's grants for this app, her To do (@kete/center). Without
# it, the app works alone with the defaults of its permissions.
ENTERPRISE_API_URL=""
# « Demander » (@kete/ai): the model, chosen by configuration. Without it, the assistant says it is
# not connected.
KETE_AI_PROVIDER=""
KETE_AI_MODEL=""
KETE_AI_API_KEY=""
# WhatsApp and Telegram (@kete/notify): seals each organization's sender — 32 random bytes in
# base64 (openssl rand -base64 32). Without it, no sender can be connected.
KETE_SECRETS_KEY=""
# The token the WhatsApp provider repeats when it checks this app's webhook address.
KETE_WHATSAPP_VERIFY_TOKEN=""
# Logs (@kete/log): debug, info, warn or error.
KETE_LOG_LEVEL="info"
# Kete Commitments' API: a project's funders are asked before a purchase. Empty: nothing checked.
COMMITMENTS_API_URL=""
# Tests: a Neon "test" branch (owner and application roles), or KETE_TEST_POSTGRES=container.
KETE_TEST_OWNER_URL=""
KETE_TEST_APP_URL=""
